# RESEND_API_KEY: delivers contact form enquiries by email (https://resend.com/api-keys).
# Without it, enquiries are only written to a local JSON fallback file.
RESEND_API_KEY=""

# CONTACT_TO_EMAIL: inbox that receives every enquiry.
CONTACT_TO_EMAIL="spesiotechnologies@gmail.com"

# CONTACT_FROM_EMAIL: sender identity. Must be a domain verified in Resend,
# for example "Spesio Technologies <hello@yourdomain.com>".
CONTACT_FROM_EMAIL="Spesio Technologies <onboarding@resend.dev>"
