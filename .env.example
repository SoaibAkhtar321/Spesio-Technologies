# ANTHROPIC_API_KEY: Required for the Spesio AI Assistant (Claude Messages API).
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required to deliver Project Enquiry form submissions by email.
# Get one at https://resend.com/api-keys. Without this, enquiries are only
# saved to the local JSON fallback (data/enquiries-fallback.json).
RESEND_API_KEY="MY_RESEND_API_KEY"

# CONTACT_TO_EMAIL: Inbox that receives every enquiry submitted on the site.
# Defaults to spesiotechnologies@gmail.com if not set.
CONTACT_TO_EMAIL="spesiotechnologies@gmail.com"

# CONTACT_FROM_EMAIL: Sender identity for enquiry emails. Must be a domain
# verified in your Resend account, e.g. "Spesio Technologies <enquiries@spesiotech.com>".
# Defaults to Resend's shared onboarding@resend.dev sender if not set (works
# immediately, but with lower deliverability than a verified domain).
CONTACT_FROM_EMAIL="Spesio Technologies <onboarding@resend.dev>"
